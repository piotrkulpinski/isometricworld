# Optional local settings. Copy to .env (never committed); the pipeline loads it.

# Hosting (required for dev, build, export, publish, deploy).
# Public origin of the R2 bucket (its custom domain), e.g. https://tiles.example.com
TILES_ORIGIN=
# Cloudflare account that owns the bucket and the Worker (Workers & Pages → Account ID)
CLOUDFLARE_ACCOUNT_ID=
# Contributors publishing a new region to their own R2 bucket (README "Contributing a city"): its name, and its
# jurisdiction if it was created with one (eu). Default: the production bucket.
TILES_BUCKET=
TILES_JURISDICTION=
# Domain the site is deployed to by `npm run deploy`, e.g. maps.example.com
SITE_DOMAIN=
# Worker name for `npm run deploy` when it differs from wrangler.jsonc's (a site in another account)
WORKER_NAME=

# Your own site from your own bucket (pipeline/src/site.ts; empty: Isometric World with every city).
# SITE_NAME names it, SITE_HOME is the city `/` opens instead of the city picker, SITE_REGIONS the regions it
# serves (comma-separated), SITE_MAKERS the credit line shown instead of the region's makers ("[Name](url)"
# links, " · " between lines), SITE_SOURCE the repository it is built from, SITE_ICONS a folder in web/public
# with its favicon set, SITE_HOME_ONLY=true builds only `/` (no city pages; every other path is a 404), SITE_LIVE_DATA=true
# names no data file or preview in the pages (all from the live world.json: a publish needs no deploy).
SITE_NAME=
SITE_HOME=
SITE_REGIONS=
SITE_DESCRIPTION=
SITE_MAKERS=
SITE_SOURCE=
SITE_ICONS=
SITE_HOME_ONLY=
SITE_LIVE_DATA=
# Where export and publish keep a region's published state (default data/web-state): one folder per bucket
WEB_STATE=

# How `npm run publish` writes to the bucket, first one set wins:
# - R2's S3 API: the Access Key ID and Secret Access Key of an R2 token (Cloudflare → R2 → Manage API tokens).
#   A token scoped to one bucket (Object Read & Write) works only this way: use it for a review bucket.
# - the Cloudflare REST API: a token with R2 write on the account (Workers R2 Storage: Edit).
# - neither: your wrangler login (`npx wrangler login`).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_API_TOKEN=

# Painting through fal.ai instead of the Codex CLI (optional): PAINT_BACKEND=fal and a fal.ai key. Each call's
# billed cost goes to data/derived/<area>/paint-spend.jsonl; PAINT_BUDGET_USD (per area) stops new calls.
# PAINT_FAL_ENDPOINT / PAINT_QUALITY pick the model (default openai/gpt-image-2.6/sunburst/edit, high); for
# Google's models (e.g. google/nano-banana-2.1/edit) PAINT_THINKING=minimal|medium|high sets how much they reason.
# CODEX_MODEL picks the Codex model when painting with the Codex CLI.
PAINT_BACKEND=
FAL_KEY=
PAINT_BUDGET_USD=
CODEX_MODEL=

# Chromium used by the renderer and the test scripts (default /usr/bin/chromium), and its launch flags
# (default --enable-gpu; e.g. add --use-angle=vulkan or --use-gl=egl for your GPU backend).
CHROME_PATH=
CHROME_ARGS=

# The site the test and film scripts open when no URL is passed. Empty: the running dev server, on whatever
# port it started (it writes data/dev-server.json); set it to use another site, e.g. production.
SITE_URL=
