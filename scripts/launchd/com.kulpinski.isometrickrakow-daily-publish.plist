<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily upload of the krakow region to isometrickrakow.com at 04:00 (the Mini runs on Europe/Warsaw time).
     Install, pause and remove: docs/hosting-isometrickrakow.md, "Daily upload". -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kulpinski.isometrickrakow-daily-publish</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/admin/Sites/isometricworld/scripts/daily-publish-isometrickrakow.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/admin/Library/Logs/isometrickrakow-daily-publish.launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/admin/Library/Logs/isometrickrakow-daily-publish.launchd.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
