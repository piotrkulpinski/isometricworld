---
/** /<city-slug>, e.g. /tel-aviv-yafo: the city's region, opened centred on the city. */
import MapPage from "../components/MapPage.astro";
import { siteCities, siteConfig } from "../../../pipeline/src/site.ts";

export function getStaticPaths() {
  return siteCities(siteConfig()).map((city) => ({ params: { city }, props: { city } }));
}
const { city } = Astro.props;
---
<MapPage city={city} />
